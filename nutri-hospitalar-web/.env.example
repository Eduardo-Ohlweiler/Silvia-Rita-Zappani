# Copie para .env.local e ajuste. O .env.local NÃO vai para o repositório.
#   cp .env.example .env.local
#
# Em desenvolvimento você normalmente NÃO precisa mexer em nada: o Vite faz
# proxy de /api para http://localhost:8080 (ver vite.config.ts), então o front
# chama a própria origem e não há CORS no caminho.
#
# Só variáveis com o prefixo VITE_ chegam ao código do navegador.
# NUNCA coloque segredo aqui — tudo isto vai no bundle, à vista de qualquer um.

# Base das chamadas à API.
#   dev  → /api            (usa o proxy do Vite)
#   prod → https://api.seudominio.com
VITE_API_URL=/api

# Origem pública do site, sem barra final. Entra no index.html (canonical,
# og:url, og:image) via %VITE_SITE_URL% — o robô do WhatsApp/Facebook exige URL
# absoluta. Se faltar, o Vite deixa o texto literal e o preview quebra calado.
VITE_SITE_URL=http://localhost:5173
