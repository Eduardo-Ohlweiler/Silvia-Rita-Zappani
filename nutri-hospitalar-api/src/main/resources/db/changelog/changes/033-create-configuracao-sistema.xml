<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Configuração do sistema: por ora, só a paleta de cores (docs/05 §11).

        Sem tenant_id, de propósito: a paleta é do SISTEMA, não de um cliente.
        Vale para todos os usuários de todos os tenants, e só o superadmin a
        escreve. É o mesmo raciocínio de percentil_cb (migration 020) — dado que
        não pertence a ninguém em particular.

        Uma linha só. O índice único sobre a constante `true` é o que garante
        isso no banco: uma segunda linha violaria o índice, e "qual das duas
        vale?" deixa de ser pergunta possível.

        Sem FK para usuario: a limpeza dos testes apaga todos os usuários, e o
        "quem mudou" é assunto do audit_log (pendente, docs/06 §A09).
    -->
    <changeSet id="033-create-configuracao-sistema" author="eduardo">

        <createTable tableName="configuracao_sistema">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_configuracao_sistema"/>
            </column>
            <column name="paleta" type="VARCHAR(20)" defaultValue="PADRAO">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <!-- O enum também é validado no banco, como em tenant.periodo_acesso -->
        <sql>
            ALTER TABLE configuracao_sistema ADD CONSTRAINT ck_configuracao_sistema_paleta
            CHECK (paleta IN
                ('PADRAO','MENTA','FLORESTA','LAVANDA','AMEIXA',
                 'OCEANO','CAFE','INDIGO','MALVA','JADE'));
        </sql>

        <sql>
            CREATE UNIQUE INDEX ux_configuracao_sistema_unica ON configuracao_sistema ((true));
        </sql>

        <!-- Nasce na paleta atual: subir a versão não muda a cor de ninguém -->
        <sql>
            INSERT INTO configuracao_sistema (paleta, created_at) VALUES ('PADRAO', now());
        </sql>

        <rollback>
            <dropTable tableName="configuracao_sistema"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
