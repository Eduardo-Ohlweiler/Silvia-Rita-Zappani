<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Curvas de crescimento da OMS, 0 a 60 meses: peso, estatura e IMC para a
        idade, em cinco percentis, separados por sexo.

        SEM `tenant_id`, como estado/cidade e os catálogos da fatia 3: é dado de
        referência internacional e nenhuma clínica tem a sua própria curva da
        OMS. Ver docs/01-multitenant.md §6.1.

        A fonte é a planilha `Pediatria.xlsx` (abas Percentil_M e Percentil_F),
        transcrita valor a valor — ver docs/09-calculos-pediatria.md §4. No
        eroERP esta mesma tabela vivia num arquivo TypeScript do navegador; aqui
        o cálculo é do servidor, então ela vive no banco.

        GUARDAMOS OS CINCO PERCENTIS, embora a classificação use só P15 e P85.
        P3, P50 e P97 já estão na fonte e são o que uma curva de crescimento na
        tela vai pedir. Carregar depois exigiria remexer a tabela; carregar
        agora não custa nada.

        DESCONTINUIDADE EM 25 MESES, PROPOSITAL: a estatura dá um pequeno salto
        entre 24 e 25 meses porque a OMS troca de curva ali — comprimento
        deitado até 24 meses, estatura em pé a partir de 24. NÃO "corrigir":
        os dados estão certos, o degrau é real.
    -->
    <changeSet id="015-create-percentil-oms" author="eduardo">

        <createTable tableName="percentil_oms">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_percentil_oms"/>
            </column>

            <column name="sexo" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="idade_meses" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <!-- Peso para a idade — kg -->
            <column name="peso_p3"  type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="peso_p15" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="peso_p50" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="peso_p85" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="peso_p97" type="NUMERIC(8,3)"><constraints nullable="false"/></column>

            <!-- Estatura para a idade — cm -->
            <column name="estatura_p3"  type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="estatura_p15" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="estatura_p50" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="estatura_p85" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="estatura_p97" type="NUMERIC(8,3)"><constraints nullable="false"/></column>

            <!-- IMC para a idade — kg/m² -->
            <column name="imc_p3"  type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="imc_p15" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="imc_p50" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="imc_p85" type="NUMERIC(8,3)"><constraints nullable="false"/></column>
            <column name="imc_p97" type="NUMERIC(8,3)"><constraints nullable="false"/></column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>

        <sql>
            ALTER TABLE percentil_oms ADD CONSTRAINT ck_percentil_oms_sexo
            CHECK (sexo IN ('MASCULINO', 'FEMININO'));
        </sql>

        <!-- Uma linha por sexo e mês. É por esta chave que o cálculo busca. -->
        <addUniqueConstraint tableName="percentil_oms"
                             columnNames="sexo, idade_meses"
                             constraintName="uk_percentil_oms_sexo_idade"/>

        <sql>
            ALTER TABLE percentil_oms ADD CONSTRAINT ck_percentil_oms_idade
            CHECK (idade_meses BETWEEN 0 AND 60);
        </sql>

