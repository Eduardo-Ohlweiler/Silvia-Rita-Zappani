            ('MASCULINO', 19.0, 19.9, 30.5, now()),
            ('MASCULINO', 20.0, 29.9, 31.8, now()),
            ('MASCULINO', 30.0, 39.9, 32.3, now()),
            ('MASCULINO', 40.0, 49.9, 33.0, now()),
            ('MASCULINO', 50.0, 59.9, 32.6, now()),
            ('MASCULINO', 60.0, 69.9, 32.0, now()),
            ('MASCULINO', 70.0, 79.9, 30.6, now()),
            ('MASCULINO', 80.0, 90.9, 28.9, now()),
            ('FEMININO',  18.0, 18.9, 26.7, now()),
            ('FEMININO',  19.0, 19.9, 26.8, now()),
            ('FEMININO',  20.0, 29.9, 28.1, now()),
            ('FEMININO',  30.0, 39.9, 30.3, now()),
            ('FEMININO',  40.0, 49.9, 31.4, now()),
            ('FEMININO',  50.0, 59.9, 31.9, now()),
            ('FEMININO',  60.0, 69.9, 31.4, now()),
            ('FEMININO',  70.0, 79.9, 29.9, now()),
            ('FEMININO',  80.0, 90.9, 27.8, now());
        </sql>

        <rollback>
            <dropTable tableName="percentil_cb"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
