{
  // ─────────────────────────────────────────────────────────────────
  //  JDK 21
  //
  //  A máquina tem o 17 e o 21 instalados, e o JAVA_HOME do sistema
  //  aponta para o 17. Sem estas linhas o Maven da IDE falha com
  //  "release version 21 not supported" e o language server marca erros
  //  falsos no código.
  // ─────────────────────────────────────────────────────────────────

  // JDK em que o próprio language server roda
  "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",

  // JDKs disponíveis para os projetos
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-21",
      "path": "/usr/lib/jvm/java-21-openjdk-amd64",
      "default": true
    }
  ],

  // JAVA_HOME para o Maven da IDE e para o terminal integrado
  "maven.terminal.useJavaHome": true,
  "maven.terminal.customEnv": [
    {
      "environmentVariable": "JAVA_HOME",
      "value": "/usr/lib/jvm/java-21-openjdk-amd64"
    }
  ],
  "terminal.integrated.env.linux": {
    "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64"
  },

  // ─────────────────────────────────────────────────────────────────
  //  Projeto
  // ─────────────────────────────────────────────────────────────────
  "java.compile.nullAnalysis.mode": "automatic",
  "java.format.settings.url": "",
  "files.exclude": {
    "**/target": true
  },
  "search.exclude": {
    "**/target": true,
    "**/node_modules": true
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Os documentos usam tabela em estilo compacto (|---|---|)
  "markdownlint.config": {
    "MD060": false,
    "MD013": false,
    "MD024": false,
    "MD033": false
  }
}
